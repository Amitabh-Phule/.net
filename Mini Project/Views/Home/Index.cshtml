@model IEnumerable<LocalServiceFinder.Models.Provider>

@{
    ViewData["Title"] = "Home";
    var availableOnly = ViewData["AvailableOnly"] as bool? ?? false;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Service Providers</h1>
        <p class="text-muted">Cached provider list with availability filter.</p>
    </div>
    <div>
        <a class="btn btn-primary me-2" asp-controller="Provider" asp-action="Create">Add Provider</a>
        <a class="btn btn-secondary" asp-controller="Booking" asp-action="Create">Book Service</a>
    </div>
</div>

<div class="mb-3">
    <a class="btn btn-sm @(availableOnly ? "btn-success" : "btn-outline-secondary")" asp-action="Index"
       asp-route-availableOnly="true">Available Only</a>
    <a class="btn btn-sm @(availableOnly ? "btn-outline-secondary" : "btn-success")" asp-action="Index"
       asp-route-availableOnly="false">All Providers</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Service Type</th>
            <th>Available</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var provider in Model)
        {
            <tr>
                <td>@provider.Name</td>
                <td>@provider.ServiceType</td>
                <td>@(provider.IsAvailable ? "Yes" : "No")</td>
            </tr>
        }
    </tbody>
</table>

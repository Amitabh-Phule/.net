@model IEnumerable<LocalServiceFinder.Models.Provider>

@{
    ViewData["Title"] = "Providers";
    var availableOnly = ViewData["AvailableOnly"] as bool? ?? false;
}

<h1>Providers</h1>
<p>Use this page to browse service providers and filter by availability.</p>

<div class="mb-3">
    <a class="btn btn-primary" asp-action="Create">Add New Provider</a>
    <a class="btn btn-sm @(availableOnly ? "btn-success" : "btn-outline-secondary")" asp-action="Index"
       asp-route-availableOnly="true">Available Only</a>
    <a class="btn btn-sm @(availableOnly ? "btn-outline-secondary" : "btn-success")" asp-action="Index"
       asp-route-availableOnly="false">All Providers</a>
</div>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>Service Type</th>
            <th>Available</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var provider in Model)
        {
            <tr>
                <td>@provider.Name</td>
                <td>@provider.ServiceType</td>
                <td>@(provider.IsAvailable ? "Yes" : "No")</td>
            </tr>
        }
    </tbody>
</table>

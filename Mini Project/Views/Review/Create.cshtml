@model LocalServiceFinder.Models.Review

@{
    ViewData["Title"] = "Add Review";
}

<h1>Add Provider Review</h1>
<p>Choose a provider and leave a rating with a comment.</p>

<form asp-action="Create" method="post" class="row g-3">
    <div class="col-md-6">
        <label asp-for="ProviderId" class="form-label"></label>
        <select asp-for="ProviderId" class="form-select" asp-items="@(ViewData["Providers"] as SelectList)">
            <option value="">Select a provider</option>
        </select>
        <span asp-validation-for="ProviderId" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Rating" class="form-label"></label>
        <input asp-for="Rating" class="form-control" type="number" min="1" max="5" />
        <span asp-validation-for="Rating" class="text-danger"></span>
    </div>
    <div class="col-md-12">
        <label asp-for="Comment" class="form-label"></label>
        <textarea asp-for="Comment" class="form-control" rows="3"></textarea>
    </div>
    <div class="col-12 mt-3">
        <button type="submit" class="btn btn-primary">Submit Review</button>
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
